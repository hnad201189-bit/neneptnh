# Sao chép file này thành ".env" rồi điền giá trị thật trước khi chạy.

# Dev dùng SQLite (không cần cài đặt gì thêm) — chỉ là đường dẫn file.
# Khi lên production: đổi khối "type" trong src/database/database.module.ts
# (và src/database/data-source.ts) thành "postgres", thêm các biến
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME tương ứng (đúng khuyến nghị
# PostgreSQL trong tài liệu kiến trúc).
DATABASE_PATH="dev.db"

PORT=3000

# Bắt buộc đổi 2 chuỗi bí mật này trước khi triển khai thật — dùng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# để sinh giá trị ngẫu nhiên, không dùng chung một secret cho cả hai token.
JWT_ACCESS_SECRET="doi-chuoi-bi-mat-nay-truoc-khi-trien-khai-that-access"
JWT_REFRESH_SECRET="doi-chuoi-bi-mat-nay-truoc-khi-trien-khai-that-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# true khi chạy sau HTTPS thật (production); để false khi test trên localhost (http)
COOKIE_SECURE=false
